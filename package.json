{
  "name": "corveno-poller",
  "private": true,
  "version": "1.0.0",
  "description": "Corveno job corpus poller — public ATS boards + seed lists",
  "scripts": {
    "build": "esbuild src/run.ts --bundle --platform=node --format=cjs --outfile=dist/run.cjs",
    "poll": "node dist/run.cjs poll",
    "seed": "node dist/run.cjs seed",
    "verify": "node dist/run.cjs verify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-dist --log-level=warning && node --test .test-dist/*.test.js",
    "sync": "./sync-from-app.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1"
  }
}
